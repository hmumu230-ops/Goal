{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(write|edit|apply_patch|notebook_edit|exit_plan_mode)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/devin/hooks/plan-mode.py\" PreToolUse",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^exec$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/devin/hooks/plan-mode.py\" PreToolUse",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^run_subagent$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/devin/hooks/plan-mode.py\" PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/devin/hooks/goal-mode.py\" PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/devin/hooks/goal-mode.py\" SessionStart",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/devin/hooks/plan-mode.py\" SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/devin/hooks/goal-mode.py\" UserPromptSubmit",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/devin/hooks/plan-mode.py\" UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompaction": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/devin/hooks/goal-mode.py\" PostCompaction",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/devin/hooks/plan-mode.py\" PostCompaction",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/devin/hooks/goal-mode.py\" Stop",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/devin/hooks/plan-mode.py\" Stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
