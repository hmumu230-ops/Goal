{
  "hooks": {
    "_comment": "钩子接线示例。命令是双路径自回退形式：先试 /mnt/c（Windows 下的 WSL 执行环境），再试 $HOME（Linux/macOS）。Windows 用户唯一要改的是把 <WIN_USER> 换成你的 Windows 用户名。⚠️ 绝对不要写 C:\\ 形式的 Windows 路径——钩子在 WSL 里跑，C:\\ 会被当成相对路径导致 python3 file-not-found 退出码 2，而钩子协议里 exit 2 = block，会把输入框锁死（Prompt blocked）。|| true 是防锁死兜底：钩子崩了静默失效而不是卡死输入。改完 config 需重开会话才生效（钩子按会话缓存，不热重载）。",

    "PreToolUse": [
      {
        "matcher": "^(write|edit|apply_patch|notebook_edit|exit_plan_mode)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/mnt/c/Users/<WIN_USER>/AppData/Roaming/devin/hooks/plan-mode.py\" PreToolUse 2>/dev/null || python3 \"$HOME/.config/devin/hooks/plan-mode.py\" PreToolUse || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^exec$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/mnt/c/Users/<WIN_USER>/AppData/Roaming/devin/hooks/plan-mode.py\" PreToolUse 2>/dev/null || python3 \"$HOME/.config/devin/hooks/plan-mode.py\" PreToolUse || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^run_subagent$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/mnt/c/Users/<WIN_USER>/AppData/Roaming/devin/hooks/plan-mode.py\" PreToolUse 2>/dev/null || python3 \"$HOME/.config/devin/hooks/plan-mode.py\" PreToolUse || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/mnt/c/Users/<WIN_USER>/AppData/Roaming/devin/hooks/goal-mode.py\" PostToolUse 2>/dev/null || python3 \"$HOME/.config/devin/hooks/goal-mode.py\" PostToolUse || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/mnt/c/Users/<WIN_USER>/AppData/Roaming/devin/hooks/goal-mode.py\" SessionStart 2>/dev/null || python3 \"$HOME/.config/devin/hooks/goal-mode.py\" SessionStart || true",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/mnt/c/Users/<WIN_USER>/AppData/Roaming/devin/hooks/plan-mode.py\" SessionStart 2>/dev/null || python3 \"$HOME/.config/devin/hooks/plan-mode.py\" SessionStart || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/mnt/c/Users/<WIN_USER>/AppData/Roaming/devin/hooks/goal-mode.py\" UserPromptSubmit 2>/dev/null || python3 \"$HOME/.config/devin/hooks/goal-mode.py\" UserPromptSubmit || true",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/mnt/c/Users/<WIN_USER>/AppData/Roaming/devin/hooks/plan-mode.py\" UserPromptSubmit 2>/dev/null || python3 \"$HOME/.config/devin/hooks/plan-mode.py\" UserPromptSubmit || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompaction": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/mnt/c/Users/<WIN_USER>/AppData/Roaming/devin/hooks/goal-mode.py\" PostCompaction 2>/dev/null || python3 \"$HOME/.config/devin/hooks/goal-mode.py\" PostCompaction || true",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/mnt/c/Users/<WIN_USER>/AppData/Roaming/devin/hooks/plan-mode.py\" PostCompaction 2>/dev/null || python3 \"$HOME/.config/devin/hooks/plan-mode.py\" PostCompaction || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/mnt/c/Users/<WIN_USER>/AppData/Roaming/devin/hooks/goal-mode.py\" Stop 2>/dev/null || python3 \"$HOME/.config/devin/hooks/goal-mode.py\" Stop || true",
            "timeout": 360
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/mnt/c/Users/<WIN_USER>/AppData/Roaming/devin/hooks/plan-mode.py\" Stop 2>/dev/null || python3 \"$HOME/.config/devin/hooks/plan-mode.py\" Stop || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
